{
  "name": "bb-plugin-cozy-hq",
  "version": "0.6.1",
  "description": "A cozy pixel-art office where every bb thread is a little worker: busy ones at desks, planners at the whiteboard, threads that need you in the waiting room. A full-panel home screen with provider usage, an office TV, festivals through the year and sound.",
  "keywords": [
    "bb-plugin",
    "pixel-art",
    "office",
    "threads",
    "home",
    "usage"
  ],
  "license": "MIT",
  "author": "Alexander Klimetschek",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexkli/bb-plugin-cozy-hq.git"
  },
  "type": "module",
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test office/*.test.ts",
    "build": "bb plugin build",
    "preview": "deno bundle --quiet --config preview/deno.json --platform=browser --format=iife -o preview/dist/main.js preview/main.tsx"
  },
  "bb": {
    "name": "Cozy HQ",
    "description": "A cozy pixel-art office where every bb thread is a little worker: busy ones at desks, planners at the whiteboard, threads that need you in the waiting room. A full-panel home screen with provider usage, an office TV, festivals through the year and sound.",
    "branding": {
      "icon": "./assets/icon.svg",
      "experimental_icons": {
        "office": "./assets/icon.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "@pierre/diffs": "~1.2.12",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  }
}
